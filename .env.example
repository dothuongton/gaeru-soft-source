# Gaeru Soft Environment Variables

# Comma-separated list of staff emails who have permission to access the admin/staff panel
STAFF_EMAILS=staff@example.com,admin@example.com

# Web Push VAPID Configuration
# Generate new keys by running: npm run generate-vapid
#
# VAPID_PUBLIC_KEY: Raw uncompressed P-256 public key (65 bytes, base64url encoded)
# VAPID_PRIVATE_KEY: Raw P-256 private key scalar 'd' (32 bytes, base64url encoded)
# VAPID_SUBJECT: mailto: address or https:// URL identifying the sender to push services
VAPID_PUBLIC_KEY=BFoaSiQ8Ew5V9YDTw5jeLlI0IxrrCYHYFx0uj6Ekkd5OfgWLBbra2VzNZ1vuCyjD3PkG1jUtZSQYQu-6fcqpTp8
VAPID_PRIVATE_KEY=mXb66F5_TLD5lAg8W2SqWJjc9MgkYlRs3tuT1X9TFDk
VAPID_SUBJECT=mailto:admin@example.com
