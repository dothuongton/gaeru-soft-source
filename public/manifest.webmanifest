{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/gaeru",
  "name": "GAERU Soft — Quản lý & Gọi món",
  "short_name": "GAERU Soft",
  "description": "Hệ thống gọi món QR và vận hành quán ăn, cà phê tối ưu điện thoại và tablet.",
  "start_url": "/gaeru",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8faf9",
  "theme_color": "#244f3c",
  "lang": "vi",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
